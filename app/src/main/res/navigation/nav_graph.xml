<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- HU-01: fingerprint login -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.univalle.dogapp.view.fragment.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login">
        <!-- Pop login off the back stack so "back" from Home does not return to it -->
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- HU-02: Home Administrador de Citas (placeholder) -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.univalle.dogapp.view.fragment.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home">
        <!-- HU-02 criterion 4: pink FAB opens Nueva Cita -->
        <action
            android:id="@+id/action_homeFragment_to_newAppointmentFragment"
            app:destination="@id/newAppointmentFragment" />
    </fragment>

    <!-- HU-03: Nueva Cita -->
    <fragment
        android:id="@+id/newAppointmentFragment"
        android:name="com.univalle.dogapp.view.fragment.NewAppointmentFragment"
        android:label="fragment_new_appointment"
        tools:layout="@layout/fragment_new_appointment" />

</navigation>
